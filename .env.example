# ---------------------------------------------------------------
# PizzaHub API - copy this file to server/.env and fill in values.
# Never commit the real .env file.
# ---------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string, including the database name.
# Example shape (replace the placeholders):
# mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/pizzahub?retryWrites=true&w=majority
MONGODB_URI=

# Frontend origin used for CORS and for Better Auth callback URLs.
CLIENT_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Required secrets. Generate each one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Google OAuth (optional - Google sign-in is hidden when these are empty).
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe - Vendor Premium subscriptions only, never customer pizza orders.
# Create a recurring monthly price in the Stripe dashboard and paste its ID.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# ImgBB image uploads (optional - uploads return 503 when empty).
IMGBB_API_KEY=

# Admin seed input. ADMIN_PASSWORD may stay empty: the seed script then
# generates a strong password and prints it once.
ADMIN_NAME=PizzaHub Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
